# کپی کن به .env و مقدارها را پر کن — این فایل هرگز کامیت نشود

# باید عین همان secret ای باشد که در داشبورد برد (کارت Attendance Server)
# وارد می‌کنی
ATTENDANCE_SECRET=change-me-long-random

# مسیر دیتابیس داخل کانتینر — volume را به همین مسیر وصل کن
SQLITE_PATH=/data/attendance.db

# هر چند ثانیه یک‌بار صف pending به گوگل/بله فرستاده شود
WORKER_INTERVAL_S=15

# ---------- Google Sheets از طریق Apps Script (اختیاری) ----------
# 1. یک Google Sheet بساز → Extensions → Apps Script → محتوای
#    docs/attendance/attendance-webhook.gs را پیست کن
# 2. در اسکریپت SECRET را عوض کن و همان را در GOOGLE_SCRIPT_SECRET بگذار
# 3. Deploy → Web app → Execute as: Me → Access: Anyone → آدرس /exec را اینجا:
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ---------- ربات بله (اختیاری) ----------
# توکن از BotFather بله + chat_id مقصد (گروه یا کاربر)
BALE_TOKEN=
BALE_CHAT_ID=
