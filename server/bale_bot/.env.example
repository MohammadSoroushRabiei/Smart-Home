# توکن ربات بله (همان توکنی که سرور attendance برای اعلان‌ها استفاده می‌کند)
BALE_TOKEN=

# chat_id های مجاز، جدا با کاما.
# خالی بگذارید تا در «حالت یادگیری»، chat_id چت شما در لاگ و در پیام ربات چاپ شود.
BALE_ALLOWED_CHATS=

# آدرس HTTPS برد (گواهی self-signed است و ربات آن را تأیید نمی‌کند؛
# بدون https:// هم بنویسید خودش اضافه می‌کند)
BOARD_URL=https://192.168.1.42

# دریافت رویداد از برد (POST /api/event): secret باید همان ATTENDANCE_SECRET
# سرور attendance باشد - برد یک secret برای هر دو سرور می‌فرستد
BALE_BOT_SECRET=
BALE_EVENT_PORT=8001

# فاصله‌ی snapshot تحلیل داده از /api/status برد (ثانیه؛ ۶۰۰ = هر ۱۰ دقیقه)
BALE_SNAPSHOT_INTERVAL_S=600

# اختیاری
BALE_POLL_TIMEOUT_S=25
# BALE_OFFSET_FILE=./bale_state.json
# BALE_DB_PATH=./data/bale_bot.db
# BALE_LOG_LEVEL=INFO
